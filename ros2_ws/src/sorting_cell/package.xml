<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_cell</name>
  <version>0.1.0</version>
  <description>ROS 2 robotic arm subsystem for Autonomous Conveyor Sorting Cell</description>
  <maintainer email="gracemariajames05@gmail.com">Grace Maria James</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!--
    The real (mock_mode:=false) PN532 RFID backend in rfid_reader.py needs
    adafruit-blinka and adafruit-circuitpython-pn532. These are pip-only
    CircuitPython hardware libraries with no rosdep/apt key, so they are
    intentionally not declared as <exec_depend> above (that would break
    `rosdep install`). Install them with `pip3 install -r requirements.txt`
    from this package's directory on the Raspberry Pi.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
